                    p.kategoriGender.toLowerCase() === filterCategoryName.toLowerCase();

                const matchSearch = 
                    p.nama.toLowerCase().includes(searchQuery.toLowerCase()) ||
                    p.merek.toLowerCase().includes(searchQuery.toLowerCase()) ||
                    p.spesifikasi.toLowerCase().includes(searchQuery.toLowerCase());

                return matchCategory && matchSearch;
            });

            // Render Promo Section (Selalu mengambil produk promo yang aktif)
            const promoProducts = products.filter(p => p.isPromo);
