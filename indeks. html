        // CART LOGIC
        function addToCart(productId) {
            const prod = products.find(p => p.id === productId);
            if(!prod) return;

            if(prod.stok <= 0) {
                showToast("Maaf, stok baju ini sedang habis!");
                return;
            }

            const existing = cart.find(item => item.id === productId);
            if(existing) {
                if(existing.qty >= prod.stok) {
                    showToast("Jumlah melebihi stok yang tersedia!");
                    return;
                }
                existing.qty += 1;
            } else {
                cart.push({
                    id: prod.id,
                    nama: prod.nama,
                    harga: prod.isPromo ? prod.hargaPromo : prod.harga,
                    qty: 1,
                    ukuranSelected: prod.ukuran[0]
                });
            }

            updateCartUI();
            showToast(`" ${prod.nama} " ditambahkan ke keranjang!`);
        }

        function updateCartQty(id, change) {
            const item = cart.find(c => c.id === id);
            if(!item) return;

            const prod = products.find(p => p.id === id);

            item.qty += change;
            if(item.qty <= 0) {
                cart = cart.filter(c => c.id !== id);
            } else if(item.qty > prod.stok) {
                item.qty = prod.stok;
                showToast("Mencapai batas stok!");
            }
            updateCartUI();
        }

        function updateCartUI() {
            const badge = document.getElementById('cartBadge');
            const list = document.getElementById('cartItemsList');
            const totalEl = document.getElementById('cartTotalPrice');

            const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
            badge.innerText = totalQty;

            list.innerHTML = '';
            let grandTotal = 0;

            if(cart.length === 0) {
                list.innerHTML = `<p class="text-xs text-center py-6 text-slate-400">Keranjang masih kosong.</p>`;
            } else {
                cart.forEach(item => {
                    const subtotal = item.harga * item.qty;
                    grandTotal += subtotal;

                    const row = document.createElement('div');
                    row.className = "flex items-center justify-between bg-slate-50 p-2.5 rounded-xl text-xs border border-slate-200";
                    row.innerHTML = `
                        <div class="max-w-[180px]">
                            <div class="font-bold text-slate-800 line-clamp-1">${item.nama}</div>
                            <div class="text-[10px] text-slate-500">Rp ${item.harga.toLocaleString('id-ID')}</div>
                        </div>
                        <div class="flex items-center space-x-2">
                            <button onclick="updateCartQty(${item.id}, -1)" class="w-6 h-6 bg-slate-200 rounded-lg text-slate-700 font-bold hover:bg-slate-300">-</button>
                            <span class="font-bold text-slate-800">${item.qty}</span>
                            <button onclick="updateCartQty(${item.id}, 1)" class="w-6 h-6 bg-slate-200 rounded-lg text-slate-700 font-bold hover:bg-slate-300">+</button>
                        </div>
                        <div class="font-bold text-indigo-600">Rp ${subtotal.toLocaleString('id-ID')}</div>
                    `;
                    list.appendChild(row);
                });
            }

            totalEl.innerText = "Rp " + grandTotal.toLocaleString('id-ID');
        }

        // SUBMIT ORDER (VIA WEB OR WHATSAPP)
        function submitOrder(e) {
            e.preventDefault();

            if(cart.length === 0) {
                showToast("Keranjang belanja Anda masih kosong!");
                return;
            }

            const nama = document.getElementById('orderNama').value;
            const hp = document.getElementById('orderHP').value;
            const alamat = document.getElementById('orderAlamat').value;
            const method = document.getElementById('orderMethod').value;
            const payment = document.getElementById('orderPayment').value;

            const grandTotal = cart.reduce((sum, i) => sum + (i.harga * i.qty), 0);

            if(method === "WhatsApp") {
                // FORMAT TULISAN KE WA (0813 3933 7200)
                let text = `*PESANAN BARU VIA WEBSITE (iqblll)*\n\n`;
                text += `*Nama:* ${nama}\n`;
                text += `*No HP:* ${hp}\n`;
                text += `*Alamat:* ${alamat}\n`;
                text += `*Metode Pembayaran:* ${payment}\n\n`;
                text += `*Daftar Pesanan Baju:*\n`;

                cart.forEach((item, index) => {
                    text += `${index+1}. ${item.nama} (${item.qty}x) = Rp ${(item.harga * item.qty).toLocaleString('id-ID')}\n`;
                });

                text += `\n*TOTAL BAYAR:* Rp ${grandTotal.toLocaleString('id-ID')}\n\n`;
                text += `Mohon segera diproses pesanan saya, Terima Kasih!`;

                const waUrl = `https://wa.me/6281339337200?text=${encodeURIComponent(text)}`;
                window.open(waUrl, '_blank');
            } else {
                // ORDER DIRECT WEBSITE
                alert(`Terima kasih ${nama}! Pesanan Anda berhasil dibuat melalui Website iqblll.\n\nTotal: Rp ${grandTotal.toLocaleString('id-ID')}\nPembayaran: ${payment}\n\nTim iqblll akan segera menghubungi WhatsApp Anda (${hp}).`);
            }

            // Potong Stok
            cart.forEach(c => {
                const p = products.find(prod => prod.id === c.id);
                if(p) p.stok -= c.qty;
            });

            // Reset Cart
            cart = [];
            updateCartUI();
            closeModal('modalCart');
            renderProducts();
            showToast("Pesanan Anda berhasil dikirim!");
        }

        // INPUT STOK BARU (FITUR OWNER)
        function toggleHargaPromoInput() {
            const isPromo = document.getElementById('inputIsPromo').value === 'true';
            const promoContainer = document.getElementById('promoHargaContainer');
            if(isPromo) {
                promoContainer.classList.remove('hidden');
            } else {
                promoContainer.classList.add('hidden');
            }
        }

        function handleInputStok(e) {
            e.preventDefault();

            const nama = document.getElementById('inputNama').value;
            const usia = document.getElementById('inputUsia').value;
            const gender = document.getElementById('inputGender').value;
            const merek = document.getElementById('inputMerek').value;
            const stok = parseInt(document.getElementById('inputStok').value);
            const harga = parseInt(document.getElementById('inputHarga').value);
            const isPromo = document.getElementById('inputIsPromo').value === 'true';
            const hargaPromo = isPromo ? parseInt(document.getElementById('inputHargaPromo').value || harga) : 0;
            const ukuranStr = document.getElementById('inputUkuran').value;
            const gambar = document.getElementById('inputGambar').value || 'https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=500&auto=format&fit=crop&q=60';
            const spesifikasi = document.getElementById('inputSpesifikasi').value;

            const newProduct = {
                id: Date.now(),
                nama: nama,
                kategoriUsia: usia,
                kategoriGender: gender,
                merek: merek,
                harga: harga,
                hargaPromo: hargaPromo,
                isPromo: isPromo,
                ukuran: ukuranStr.split(',').map(s => s.trim().toUpperCase()),
                stok: stok,
                spesifikasi: spesifikasi,
                gambar: gambar
            };

            // Tambahkan ke array utama (posisi depan)
            products.unshift(newProduct);

            // Re-render
            renderProducts();
            closeModal('modalInputStok');
            document.getElementById('formInputStok').reset();
            showToast("Stok produk baru berhasil ditambahkan ke Etalase!");
        }

        // CATEGORY & SEARCH FILTER
        function filterCategory(cat) {
            const katalogTitle = document.getElementById('katalogTitle');
            if(cat === 'all') katalogTitle.innerText = "Semua Koleksi Baju";
            else if(cat === 'promo') katalogTitle.innerText = "Katalog Diskon Promo";
            else katalogTitle.innerText = `Koleksi Baju (${cat})`;

            renderProducts(cat, document.getElementById('searchInput').value);
        }

        function handleSearch() {
            const query = document.getElementById('searchInput').value;
            renderProducts('all', query);
        }

        // MODAL HELPERS
        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        // TOAST NOTIFICATION
        function showToast(msg) {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toastMessage');
            toastMessage.innerText = msg;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3000);
        }
    </script>
</body>
